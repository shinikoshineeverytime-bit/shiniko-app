{
  "expo": {
    "name": "Shiniko",
    "slug": "shiniko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shiniko",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shiniko.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shiniko uses your location to find car washers near you and show them where your car is.",
        "NSLocationAlwaysUsageDescription": "Shiniko uses your location to connect you with nearby car washers."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC8rhnTkdB7ocVc8XEcSx_5Z4XiB46TgUY"
      }
    },
    "android": {
      "package": "com.shiniko.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC8rhnTkdB7ocVc8XEcSx_5Z4XiB46TgUY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shiniko uses your location to find car washers near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00D4AA"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "shinikoshineeverytime"
  }
}
